# Flask App Config
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=0
SECRET_KEY=generate_a_random_secure_hex_secret_here

# Database Config (SQLite locally, PostgreSQL on Render/Heroku)
# Local: sqlite:///daily_code_exam.db
# Render PostgreSQL example: postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///daily_code_exam.db

# Code Execution Engine
# Options: piston or judge0
EXECUTOR=piston
EXECUTOR_URL=https://emkc.org/api/v2/piston/execute
EXECUTOR_API_KEY=

# Groq AI Question Generation & Evaluation
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Time Window Override for Local Testing (Set to true to test Run/Submit outside 9-10 PM IST)
BYPASS_TIME_WINDOW=false

# Session and Cookie Security
SESSION_COOKIE_SECURE=false

# Admin Initial Setup (Optional initial seed credentials)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@dailycodeexam.com
INITIAL_ADMIN_PASSWORD=AdminSecurePass!2026#
